# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# There is NO Morningstar password setting, on purpose. Signing in happens
# once, by hand, in a browser window opened by:
#
#   python -m screener.cli login
#
# The account holder types their own password there. Only the resulting
# session cookie is saved, to auth/morningstar_state.json (also gitignored).

# Optional: Slack or Discord incoming webhook. Buy signals get posted here.
SCREENER_WEBHOOK_URL=
